{
  "name": "onix-engine",
  "version": "0.1.0",
  "description": "ONIX for Books codelists and schema foundation.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.17.0",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "generate": "tsx scripts/import-codelists.ts && tsx scripts/import-onix-schema.ts",
    "generate:schema": "tsx scripts/import-onix-schema.ts",
    "validate:data": "tsx scripts/validate-codelists.ts && tsx scripts/validate-onix-schema.ts",
    "build": "tsup",
    "demo": "vite examples/codelist-browser",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "saxes": "^6.0.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vite": "^7.3.6",
    "vitest": "^3.0.9"
  },
  "keywords": [
    "onix",
    "books",
    "codelists",
    "editeur"
  ],
  "homepage": "https://github.com/kisara/onix-engine",
  "notice": "NOTICE"
}
