{
  "name": "onix-engine",
  "version": "1.0.0",
  "description": "Build ONIX for Books 3.1 XML, validate it against official XSDs, and explore codelists and Thema.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.17.0",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./xml": {
      "types": "./dist/xml.d.ts",
      "import": "./dist/xml.js",
      "require": "./dist/xml.cjs"
    },
    "./validation": {
      "types": "./dist/validation.d.ts",
      "import": "./dist/validation.js",
      "require": "./dist/validation.cjs"
    },
    "./builders": {
      "types": "./dist/builders.d.ts",
      "import": "./dist/builders.js",
      "require": "./dist/builders.cjs"
    },
    "./codelists": {
      "types": "./dist/codelists.d.ts",
      "import": "./dist/codelists.js",
      "require": "./dist/codelists.cjs"
    },
    "./thema": {
      "types": "./dist/thema.d.ts",
      "import": "./dist/thema.js",
      "require": "./dist/thema.cjs"
    }
  },
  "files": [
    "dist",
    "standards/onix/3.1.3",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "generate": "tsx scripts/import-codelists.ts && tsx scripts/import-onix-schema.ts",
    "generate:schema": "tsx scripts/import-onix-schema.ts",
    "validate:data": "tsx scripts/validate-codelists.ts && tsx scripts/verify-standards.ts",
    "build": "tsup",
    "demo:build": "tsup demo/main.ts --format esm --platform browser --target es2022 --out-dir demo/dist --no-splitting --clean --no-dts",
    "demo": "pnpm demo:build && tsx scripts/serve-demo.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "xmllint-wasm": "5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "saxes": "^6.0.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.0.9"
  },
  "keywords": [
    "onix",
    "books",
    "codelists",
    "editeur",
    "xml"
  ],
  "homepage": "https://github.com/kisara/onix-engine",
  "notice": "NOTICE"
}
